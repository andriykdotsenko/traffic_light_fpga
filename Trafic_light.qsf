set_global_assignment -name FAMILY "MAX II"
set_global_assignment -name DEVICE EPM570T100C3
set_global_assignment -name TOP_LEVEL_ENTITY Trafic_light
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_CREATION_TIME_DATE "00:48:30  OCTOBER 21, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR "-1"
set_global_assignment -name POWER_EXT_SUPPLY_VOLTAGE_TO_REGULATOR 3.3V
set_global_assignment -name SYSTEMVERILOG_FILE Trafic_light.sv
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_location_assignment PIN_64 -to clk
set_location_assignment PIN_50 -to btn_next
set_location_assignment PIN_48 -to btn_rst
set_location_assignment PIN_55 -to green_lamp
set_location_assignment PIN_57 -to red_lamp
set_location_assignment PIN_53 -to yellow_lamp
set_location_assignment PIN_4 -to seg_ones[0]
set_location_assignment PIN_5 -to seg_ones[1]
