set_location_assignment PIN_7 -to seg_ones[3]
set_location_assignment PIN_8 -to seg_ones[4]
set_location_assignment PIN_12 -to seg_ones[5]
set_location_assignment PIN_14 -to seg_ones[6]
set_location_assignment PIN_96 -to seg_tens[0]
set_location_assignment PIN_95 -to seg_tens[1]
set_location_assignment PIN_92 -to seg_tens[2]
set_location_assignment PIN_91 -to seg_tens[3]
set_location_assignment PIN_89 -to seg_tens[4]
set_location_assignment PIN_87 -to seg_tens[5]
set_location_assignment PIN_86 -to seg_tens[6]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to btn_next
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to btn_rst